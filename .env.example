# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection (required): postgres://USER:PASSWORD@HOST:5432/DBNAME
# If the password contains special characters, URL-encode them (for example @ becomes %40).
DATABASE_URL=postgres://amstack:amstack@localhost:5432/amstack

# Browser origins allowed to call the API (only needed when Next.js runs on another origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
